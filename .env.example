# Telegram Bot Configuration
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ  # Replace with your Telegram Bot token from @BotFather
ADMIN_IDS=123456789,987654321                    # Comma-separated Telegram User IDs of administrators
TELEGRAM_PROXY=                                  # Optional proxy URL (e.g. http://proxy.server:3128)

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///pokeempire.db

# Game Balance Variables
SHINY_RATE=0.002                                 # Chance of a shiny encounter (e.g. 0.002 = 1 in 500)
HUNT_COOLDOWN=30                                 # Cooldown between hunting encounters in seconds
WORK_COOLDOWN=3600                               # Cooldown for the work command in seconds
DAILY_REWARD_COINS=250                           # Standard daily login coin reward
DAILY_REWARD_GEMS=5                              # Standard daily login gem reward
AUCTION_CHANNEL=@PokeEmpireAuctions                 # Channel where auction settlement reports are published

